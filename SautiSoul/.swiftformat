# SwiftFormat Configuration for Sauti Soul

# Indentation
--indent 4
--tabwidth 4
--indentcase false

# Line length
--maxwidth 120

# Spacing
--operatorfunc spaced
--nospaceoperators ...,..<
--ranges spaced

# Wrapping
--wraparguments before-first
--wrapparameters before-first
--wrapcollections before-first
--closingparen balanced

# Semicolons
--semicolons never

# Imports
--importgrouping testable-bottom
--importgrouping alphabetical

# Other
--disable redundantSelf
--disable redundantReturn
--disable redundantParens
--enable isEmpty
--enable sortedImports
--enable strongifiedSelf

# Excluded paths
--exclude Pods
--exclude build
--exclude DerivedData
--exclude .build

